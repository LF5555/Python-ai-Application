# Google AI Studio（https://aistudio.google.com/apikey）で取得した Gemini の API キー
GEMINI_API_KEY=your-gemini-api-key

# Cloudflare ダッシュボード > AI > Workers AI > 「REST API を使用」から取得
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_API_TOKEN=your-api-token

# ログイン画面のユーザー名とパスワード（両方とも空ならログイン画面なし）
APP_AUTH_USER=
APP_AUTH_PASSWORD=
